{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: save store, open / save dialogs, and reading / writing the files picked in them",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
