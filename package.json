{
  "name": "grantria-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "assets": "python -I tools/build_web_assets.py",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode pages",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "ref": "python -I tools/build_ref_maps.py",
    "fixtures": "python -I tools/grantria_shop.py --assets apk/assets --so apk/lib/armeabi/libGrantria.so --out tests/fixtures/shop && python -I tools/grantria_skilldetail.py",
    "test": "node --import ./tests/register.mjs --test \"tests/**/*.test.ts\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-fs": "2.6.0",
    "galmuri": "2.40.3",
    "three": "0.170.0",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "7.3.7"
  }
}
